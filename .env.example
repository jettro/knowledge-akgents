# LLM: gpt-5.6-luna is served over an OpenAI-compatible endpoint.
OPENAI_API_KEY=
# Set OPENAI_BASE_URL if the model lives behind a gateway (leave blank for api.openai.com).
OPENAI_BASE_URL=

# Web fetch / crawl (Tavily).
TAVILY_API_KEY=

# Vector store. For local `make run`, point at a local Qdrant (docker run -p 6333:6333 qdrant/qdrant).
# In docker compose this is set automatically to http://qdrant:6333.
AKGENTIC_QDRANT_URL=http://localhost:6333
# AKGENTIC_QDRANT_API_KEY=
